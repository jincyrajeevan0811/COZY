# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=Asia/Kolkata
# Obscure admin paths (end with a slash)
DJANGO_ADMIN_URL=secure-django-admin/
DASHBOARD_URL=cozy-admin/

# --- Database: sqlite (dev) or mysql ---
DB_ENGINE=sqlite
DB_NAME=cozy
DB_USER=cozy
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Cache (optional) ---
REDIS_URL=

# --- Email (console backend prints emails in the terminal during development) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=COZY <no-reply@yourdomain.com>

# --- Razorpay (use TEST keys first: rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UNPAID_ORDER_TIMEOUT_MINUTES=30

# --- Optional WhatsApp gateway (generic JSON API, leave blank to disable) ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Security / limits ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900
MAX_IMAGE_UPLOAD_MB=5
# Production only
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
